CREATE TABLE DimCustomer_SCD (
  CustomerKey INT PRIMARY KEY AUTO_INCREMENT,
  CustomerID INT,
  CustomerName VARCHAR(100),
  City VARCHAR(50),
  StartDate DATE,
  EndDate DATE,
  CurrentFlag CHAR(1)
);
