CREATE OR REPLACE DATABASE LOGISTICS_LAB;
CREATE OR REPLACE SCHEMA DATA;
USE DATABASE LOGISTICS_LAB;
USE SCHEMA DATA;
CREATE OR REPLACE TABLE DELIVERIES(
ORDER_ID STRING,
ORDER_DATE DATE,
CITY STRING,
VEHICLE_TYPE STRING,
DISTANCE_KM NUMBER(8,2),
DELIVERY_TIME_MIN INT,
IS_ONTIME STRING,
DRIVER_RATING NUMBER(3,1)
);
--TOTAL ORDERS
SELECT COUNT(*)AS TOTAL_ORDERS,
ROUND(100.0 * AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%'AS ONTIME_PERCENTAGE
FROM DELIVERIES;
--PERFORMANCE BY CITY
SELECT CITY,
COUNT(*)AS TOTAL_DELIVERIES,
ROUND(AVG(DELIVERY_TIME_MIN),1)AS AVG_MINUTES,
ROUND(100.0 * AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%' AS ONTIME_PCT
FROM DELIVERIES
GROUP BY CITY
ORDER BY ONTIME_PCT DESC;
--VEHICLE TYPE
SELECT VEHICLE_TYPE,
ROUND(AVG(DELIVERY_TIME_MIN),1)AS AVG_MINUTES,
ROUND(AVG(DISTANCE_KM),1)AS AVG_DISTANCE_KM,
ROUND(100.0*AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%' AS ON_TIME_PCT
FROM DELIVERIES
GROUP BY VEHICLE_TYPE
ORDER BY AVG_MINUTES;
--TOP 10 BEST RATED
SELECT ORDER_ID,DRIVER_RATING,CITY,VEHICLE_TYPE,IS_ONTIME
FROM DELIVERIES
ORDER BY DRIVER_RATING DESC
LIMIT 10;
--DAILY DELIVERY VOLUME
SELECT ORDER_DATE,
COUNT(*)AS DELIVERIES_PER_DAY
FROM DELIVERIES
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
