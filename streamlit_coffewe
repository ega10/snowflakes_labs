import streamlit as st
import pandas as pd
from snowflake.snowpark.context import get_active_session

# ----------------------------------
# Snowflake Session
# ----------------------------------
session = get_active_session()

# ----------------------------------
# Load Data
# ----------------------------------
query = """
SELECT
    SALE_DATE,
    STORE,
    PRODUCT,
    QUANTITY,
    PRICE,
    CUSTOMER_AGE,
    QUANTITY * PRICE AS REVENUE
FROM COFFEE_LAB.DATA.SALES
"""

df = session.sql(query).to_pandas()

# ----------------------------------
# Page Config
# ----------------------------------
st.set_page_config(
    page_title="Coffee Sales Dashboard",
    layout="wide"
)

st.title("☕ Coffee Sales Dashboard")

# ----------------------------------
# Filters
# ----------------------------------
st.sidebar.header("Filters")

store_filter = st.sidebar.multiselect(
    "Select Store",
    options=df["STORE"].unique(),
    default=df["STORE"].unique()
)

product_filter = st.sidebar.multiselect(
    "Select Product",
    options=df["PRODUCT"].unique(),
    default=df["PRODUCT"].unique()
)

filtered_df = df[
    (df["STORE"].isin(store_filter)) &
    (df["PRODUCT"].isin(product_filter))
]

# ----------------------------------
# KPIs
# ----------------------------------
total_revenue = filtered_df["REVENUE"].sum()
total_transactions = len(filtered_df)
avg_age = round(filtered_df["CUSTOMER_AGE"].mean(), 1)
total_qty = filtered_df["QUANTITY"].sum()

col1, col2, col3, col4 = st.columns(4)

col1.metric("Total Revenue", f"${total_revenue:,.2f}")
col2.metric("Transactions", total_transactions)
col3.metric("Average Customer Age", avg_age)
col4.metric("Quantity Sold", total_qty)

st.divider()

# ----------------------------------
# Revenue By Product
# ----------------------------------
col1, col2 = st.columns(2)

with col1:
    st.subheader("Revenue by Product")

    product_rev = (
        filtered_df.groupby("PRODUCT")["REVENUE"]
        .sum()
        .sort_values(ascending=False)
    )

    st.bar_chart(product_rev)

with col2:
    st.subheader("Revenue by Store")

    store_rev = (
        filtered_df.groupby("STORE")["REVENUE"]
        .sum()
        .sort_values(ascending=False)
    )

    st.bar_chart(store_rev)

# ----------------------------------
# Daily Sales Trend
# ----------------------------------
st.subheader("Daily Sales Trend")

daily_sales = (
    filtered_df.groupby("SALE_DATE")["REVENUE"]
    .sum()
    .reset_index()
)

daily_sales = daily_sales.sort_values("SALE_DATE")

st.line_chart(
    daily_sales,
    x="SALE_DATE",
    y="REVENUE"
)

# ----------------------------------
# Transactions By Store
# ----------------------------------
st.subheader("Transactions by Store")

transactions = (
    filtered_df.groupby("STORE")
    .size()
    .reset_index(name="TRANSACTIONS")
)

st.bar_chart(
    transactions,
    x="STORE",
    y="TRANSACTIONS"
)

# ----------------------------------
# Detailed Data
# ----------------------------------
st.subheader("Sales Details")

st.dataframe(
    filtered_df,
    use_container_width=True
)

# ----------------------------------
# Best Selling Day
# ----------------------------------
best_day = (
    filtered_df.groupby("SALE_DATE")["REVENUE"]
    .sum()
    .reset_index()
    .sort_values("REVENUE", ascending=False)
    .head(1)
)

st.subheader("🏆 Best Selling Day")

st.dataframe(best_day, use_container_width=True)

CREATE OR REPLACE DATABASE LOGISTICS_LAB;
CREATE OR REPLACE SCHEMA DATA;
USE DATABASE LOGISTICS_LAB;
USE SCHEMA DATA;
CREATE OR REPLACE TABLE DELIVERIES(
ORDER_ID STRING,
ORDER_DATE DATE,
CITY STRING,
VEHICLE_TYPE STRING,
DISTANCE_KM NUMBER(8,2),
DELIVERY_TIME_MIN INT,
IS_ONTIME STRING,
DRIVER_RATING NUMBER(3,1)
);
--TOTAL ORDERS
SELECT COUNT(*)AS TOTAL_ORDERS,
ROUND(100.0 * AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%'AS ONTIME_PERCENTAGE
FROM DELIVERIES;
--PERFORMANCE BY CITY
SELECT CITY,
COUNT(*)AS TOTAL_DELIVERIES,
ROUND(AVG(DELIVERY_TIME_MIN),1)AS AVG_MINUTES,
ROUND(100.0 * AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%' AS ONTIME_PCT
FROM DELIVERIES
GROUP BY CITY
ORDER BY ONTIME_PCT DESC;
--VEHICLE TYPE
SELECT VEHICLE_TYPE,
ROUND(AVG(DELIVERY_TIME_MIN),1)AS AVG_MINUTES,
ROUND(AVG(DISTANCE_KM),1)AS AVG_DISTANCE_KM,
ROUND(100.0*AVG(CASE WHEN IS_ONTIME='Yes'THEN 1.0 ELSE 0.0 END),1)||'%' AS ON_TIME_PCT
FROM DELIVERIES
GROUP BY VEHICLE_TYPE
ORDER BY AVG_MINUTES;
--TOP 10 BEST RATED
SELECT ORDER_ID,DRIVER_RATING,CITY,VEHICLE_TYPE,IS_ONTIME
FROM DELIVERIES
ORDER BY DRIVER_RATING DESC
LIMIT 10;
--DAILY DELIVERY VOLUME
SELECT ORDER_DATE,
COUNT(*)AS DELIVERIES_PER_DAY
FROM DELIVERIES
GROUP BY ORDER_DATE
ORDER BY ORDER_DATE;
